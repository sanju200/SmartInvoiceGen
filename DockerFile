# Stage 1: Build the application
FROM node:22-alpine AS builder

# Add build arguments for environment variables
ARG JWT_SECRET
ENV JWT_SECRET=$JWT_SECRET

WORKDIR /app

# Copy root package.json + lock file first
COPY package*.json ./
COPY prisma ./prisma/

# Install root dependencies
RUN npm install --legacy-peer-deps
RUN npx prisma generate


# Copy all files including index.html
COPY . .

# Build client
RUN npm run build

# Install server dependencies (if needed, but since server has no package.json, skip this)
# If server DOES have its own package.json, uncomment:
# RUN cd server && npm install --legacy-peer-deps

# Stage 2: Final image
FROM node:22-alpine

# Make JWT_SECRET available at runtime
ARG JWT_SECRET
ENV JWT_SECRET=$JWT_SECRET

WORKDIR /app

# Copy built files from builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma

# Set working directory to the root where package.json exists
WORKDIR /app

EXPOSE 3000

# Set the command to run the server
CMD ["node", "dist/server/node-build.mjs"]